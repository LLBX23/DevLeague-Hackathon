function switchTab(tabName) {
  state.activeTab = tabName;
  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.tab === tabName));
  document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
  document.getElementById('tab-' + tabName).classList.remove('hidden');
  renderActiveTab();
}

window.goToRole = function(roleId) {
  switchTab('role');
  state.selectedRole = roleId;
  document.getElementById('roleSelect').value = roleId;
  renderRoleView();
};

window.goToPerson = function(personId) {
  switchTab('people');
  state.selectedPerson = personId;
  document.getElementById('personSelect').value = personId;
  renderPeopleView();
};

// ============================================================
// FILE UPLOAD
// ============================================================
function initFileUpload() {
  const fileInput = document.getElementById('fileInput');
  const uploadZone = document.getElementById('uploadZone');

  function clearData(message) {
    state.records = [];
    state.roles.clear();
    state.people.clear();
    state.gaps = [];
    state.sourceName = '';
    document.getElementById('dataBadge').textContent = message;
    document.getElementById('dataBadge').className = 'badge badge-gap';
    renderUI();
  }

  function normaliseRows(rows) {
    return rows.map(row => Object.fromEntries(
      Object.entries(row).map(([key, value]) => [String(key).replace(/^\uFEFF/, '').trim().toLowerCase().replace(/[ -]+/g, '_'), String(value ?? '').trim()])
    ));
  }

  function value(row, names) {
    return names.map(name => row[name]).find(item => item !== undefined && item !== '');
  }

  function dateValue(row) {
    const raw = value(row, ['date', 'effective_date', 'valid_from', 'start_date', 'event_date', 'observed_date', 'effective_date_as_recorded', 'hire_date']) || '';
    const usDate = String(raw).match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    return usDate ? `${usDate[3]}-${usDate[1].padStart(2, '0')}-${usDate[2].padStart(2, '0')}` : raw;
  }

  function roleKey(department, title) {
    return `ROLE-${`${department}-${title}`.toUpperCase().replace(/[^A-Z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`;
  }

  function buildRecords(tables) {
    const people = new Map();
    const roleNames = new Map();
    const roles = [];
    const moves = [];

    for (const table of tables) {
      for (const row of table.rows) {
        const personId = value(row, ['person_id', 'employee_id', 'employee_number', 'staff_id']);
        const personName = value(row, ['person_name', 'full_name', 'employee_name', 'name', 'person_name_as_recorded']);
        if (personId && personName) people.set(personId, personName);
        const roleId = value(row, ['role_id', 'position_id', 'job_id', 'role_code']);
        const roleTitle = value(row, ['role_title', 'job_title', 'position_title', 'role', 'role_as_recorded']);
        if (roleId && roleTitle) roleNames.set(roleId, roleTitle);
      }
    }

    for (const table of tables) {
      const sheet = table.name.toLowerCase();
      const isRoster = table.rows.some(row =>
        value(row, ['employee_id', 'person_id', 'employee_number', 'staff_id']) &&
        value(row, ['job_title', 'role_title', 'position_title']) &&
        !row.record_type
      );

      // A current employee roster is a point-in-time organisation map. Create one
      // role record per unique title/department, then add each employee as a JOIN.
      if (isRoster) {
        const rosterRoles = new Map();
        const employeeRoleIds = new Map();
        const employeeRolesByName = new Map();

        for (const row of table.rows) {
          const personId = value(row, ['employee_id', 'person_id', 'employee_number', 'staff_id']) || '';
          const personName = value(row, ['full_name', 'person_name', 'employee_name', 'name']) || 'Unknown';
          const department = value(row, ['department', 'department_name', 'team']) || 'Unassigned';
          const title = value(row, ['job_title', 'role_title', 'position_title']) || 'Untitled role';
          const id = roleKey(department, title);
          const key = `${department}||${title}`;
          if (!rosterRoles.has(key)) rosterRoles.set(key, { id, title, department, people: [], firstDate: dateValue(row) });
          const role = rosterRoles.get(key);
          role.people.push({ row, personId, personName });
          if (dateValue(row) && (!role.firstDate || dateValue(row) < role.firstDate)) role.firstDate = dateValue(row);
          employeeRoleIds.set(personId, id);
          employeeRolesByName.set(personName.toLowerCase(), id);
        }

        for (const role of rosterRoles.values()) {
          const manager = value(role.people[0].row, ['manager', 'manager_name', 'reports_to_name']) || '';
          roles.push({
            record_type: 'ROLE', record_id: `${table.name}-${role.id}`, date: role.firstDate || new Date().toISOString().slice(0, 10),
            role_id: role.id, role_title: role.title, department: role.department,
            reports_to_role_id: employeeRolesByName.get(manager.toLowerCase()) || '', reports_to_name: manager,
            grade: '', headcount: String(role.people.length), person_id: '', person_name: '', action: '',
            notes: `Current roster role: ${role.people.length} employee${role.people.length === 1 ? '' : 's'}`
          });
          for (const person of role.people) {
            const row = person.row;
            moves.push({
              record_type: 'MOVE', record_id: `${table.name}-${person.personId}`, date: dateValue(row) || role.firstDate,
              role_id: role.id, role_title: role.title, department: role.department,
              reports_to_role_id: employeeRolesByName.get((value(row, ['manager', 'manager_name', 'reports_to_name']) || '').toLowerCase()) || '',
              reports_to_name: value(row, ['manager', 'manager_name', 'reports_to_name']) || '', grade: '', headcount: '',
              person_id: person.personId, person_name: person.personName,
              action: String(value(row, ['employment_status', 'status']) || '').toLowerCase() === 'active' ? 'JOIN' : 'LEAVE',
              notes: [value(row, ['location']), value(row, ['employment_status', 'status'])].filter(Boolean).join(' · ')
            });
          }
        }
        continue;
      }

      for (const row of table.rows) {
        const suppliedType = (row.record_type || '').toUpperCase();
        const roleId = value(row, ['role_id', 'position_id', 'job_id', 'role_code']) || '';
        const personId = value(row, ['person_id', 'employee_id', 'employee_number', 'staff_id']) || '';
        const date = dateValue(row);
        const roleTitle = value(row, ['role_title', 'job_title', 'position_title', 'role', 'role_as_recorded']) || roleNames.get(roleId) || '(unknown role)';
        const personName = value(row, ['person_name', 'full_name', 'employee_name', 'name', 'person_name_as_recorded']) || people.get(personId) || 'Unknown';
        const reportingRole = value(row, ['reports_to_role_id', 'manager_role_id', 'parent_role_id', 'reports_to_id']) || '';
        const reportingName = value(row, ['reports_to_name', 'manager_name', 'manager', 'manager_as_recorded']) || '';
        const base = {
          record_id: value(row, ['record_id', 'event_id', 'assignment_id', 'id']) || `${table.name}-${roles.length + moves.length + 1}`,
          date,
          role_id: roleId,
          role_title: roleTitle,
          department: value(row, ['department', 'department_name', 'department_as_recorded', 'team']) || '',
          reports_to_role_id: reportingRole,
          reports_to_name: reportingName,
          grade: value(row, ['grade', 'level', 'job_grade', 'band']) || '',
          headcount: value(row, ['headcount', 'fte', 'planned_headcount']) || '',
          person_id: personId,
          person_name: personName,
          action: (value(row, ['action', 'event_type', 'change_type', 'movement_type']) || '').toUpperCase(),
          notes: value(row, ['notes', 'description', 'reason', 'quality_issue']) || ''
        };

        if (suppliedType === 'ROLE' || suppliedType === 'MOVE') {
          (suppliedType === 'ROLE' ? roles : moves).push({ ...base, record_type: suppliedType });
        } else if (personId && roleId) {
          moves.push({ ...base, record_type: 'MOVE', action: base.action || (sheet.includes('assignment') ? 'JOIN' : 'UPDATE') });
        } else if (roleId && (sheet.includes('role') || sheet.includes('report') || reportingRole || roleTitle !== '(unknown role)')) {
          roles.push({ ...base, record_type: 'ROLE' });
        }
      }
    }

    return { records: [...roles, ...moves], roleCount: roles.length, moveCount: moves.length };
  }

  function importFile(file) {
    if (!file) return;
    const token = ++state.loadToken;
    const reader = new FileReader();
    reader.onerror = () => {
      if (token === state.loadToken) clearData(`Could not read ${file.name}`);
    };
    reader.onload = event => {
      // Ignore a slower, earlier read after the user has selected another file.
      if (token !== state.loadToken) return;
      try {
        const bytes = new Uint8Array(event.target.result);
        // Detect spreadsheets from their contents. Some systems label an .xlsx as .csv.
        const isXlsx = bytes[0] === 0x50 && bytes[1] === 0x4b;
        const isXls = bytes[0] === 0xd0 && bytes[1] === 0xcf && bytes[2] === 0x11 && bytes[3] === 0xe0;
        let tables;
        if (isXlsx || isXls) {
          if (!window.XLSX) throw new Error('Excel reader did not load. Please try again with a CSV file.');
          const workbook = XLSX.read(event.target.result, { type: 'array' });
          tables = workbook.SheetNames.map(name => ({
            name,
            rows: normaliseRows(XLSX.utils.sheet_to_json(workbook.Sheets[name], { defval: '', raw: false, dateNF: 'yyyy-mm-dd' }))
          })).filter(table => table.rows.length);
        } else {
          const text = new TextDecoder('utf-8').decode(event.target.result);
          tables = [{ name: 'Uploaded data', rows: normaliseRows(parseCSV(text)) }];
        }
        if (!tables.length) throw new Error('The selected file has no data rows.');
        const result = buildRecords(tables);
        if (!result.records.length) throw new Error('No role history or people assignments were recognised.');
        loadData(result.records, `${file.name} · ${result.roleCount} role records · ${result.moveCount} people records`);
      } catch (error) {
        clearData(`${file.name}: ${error.message}`);
      } finally {
        // Lets the user select the same corrected file again.
        fileInput.value = '';
      }
    };
    reader.readAsArrayBuffer(file);
  }

  fileInput.addEventListener('change', e => importFile(e.target.files[0]));

  // Drag and drop
  uploadZone.addEventListener('click', () => fileInput.click());
  uploadZone.addEventListener('dragover', e => { e.preventDefault(); uploadZone.classList.add('dragover'); });
  uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('dragover'));
  uploadZone.addEventListener('drop', e => {
    e.preventDefault();
    uploadZone.classList.remove('dragover');
    importFile(e.dataTransfer.files[0]);
  });
}

// ============================================================
// ============================================================
// INIT
// ============================================================
// ============================================================
function init() {
  // Tab switching
  document.querySelectorAll('.tab').forEach(t => {
    t.addEventListener('click', () => switchTab(t.dataset.tab));
  });

  // Role select
  document.getElementById('roleSelect').addEventListener('change', e => {
    state.selectedRole = e.target.value;
    renderRoleView();
  });

  // Person select
  document.getElementById('personSelect').addEventListener('change', e => {
    state.selectedPerson = e.target.value;
    renderPeopleView();
  });

  // Connected view selects
  document.getElementById('connectedRoleSelect').addEventListener('change', renderConnectedView);
  document.getElementById('connectedPersonSelect').addEventListener('change', renderConnectedView);

  initFileUpload();
}

init();
</script>
</body>
</html>
